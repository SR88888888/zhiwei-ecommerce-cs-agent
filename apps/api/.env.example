DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# mock is the safe local default. Set live only after configuring the adapter endpoint.
PDD_ADAPTER_MODE=mock
PDD_API_BASE_URL=
PDD_API_TOKEN=
MAX_AGENT_STEPS=3


# Local pgvector service from docker-compose.mvp.yml
DATABASE_URL=postgresql://zhiwei:zhiwei_dev@localhost:5432/zhiwei
# Enable only after the local BGE model has been downloaded.
LOCAL_EMBEDDINGS_ENABLED=false
